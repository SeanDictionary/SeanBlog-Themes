{{#if pagination.pageCount}}
<nav class="cf-pagination" aria-label="分页">
  <ul class="pagination mb-0">
    {{#if pagination.prevUrl}}<li class="page-item"><a class="page-link" href="{{pagination.prevUrl}}" rel="prev" aria-label="上一页">«</a></li>{{/if}}
    {{#each pagination.pages}}
      {{#if active}}<li class="page-item active"><span class="page-link">{{page}}</span></li>{{else}}<li class="page-item"><a class="page-link" href="{{url}}">{{page}}</a></li>{{/if}}
    {{/each}}
    {{#if pagination.nextUrl}}<li class="page-item"><a class="page-link" href="{{pagination.nextUrl}}" rel="next" aria-label="下一页">»</a></li>{{/if}}
  </ul>
</nav>
{{/if}}
