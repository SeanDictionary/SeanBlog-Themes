<header class="cf-header" data-cf-header>
  <div class="cf-header-inner" data-nav-align="{{theme.config.navAlignment}}">
    <div class="cf-header-left">
      {{#eq theme.config.showSiteName true}}<a href="/" class="navbar-brand cf-brand">{{site.title}}</a>{{/eq}}
      <nav class="nav cf-nav">
        {{#each theme.config.navItems}}<a href="{{link}}" class="nav-link cf-nav-item"{{#eq target "_blank"}} target="_blank" rel="noopener noreferrer"{{/eq}}>{{{label}}}</a>{{/each}}
        {{#eq theme.config.showSearch true}}{{#eq theme.config.searchPosition "follow-menu"}}<button type="button" data-sb-search class="nav-link cf-icon-btn" aria-label="搜索"><i class="fa-solid fa-magnifying-glass"></i></button>{{/eq}}{{/eq}}
      </nav>
    </div>
    <div class="cf-header-actions">
      {{#eq theme.config.showSearch true}}{{#eq theme.config.searchPosition "right-side"}}<button type="button" data-sb-search class="btn btn-sm btn-outline-secondary cf-icon-btn" aria-label="搜索"><i class="fa-solid fa-magnifying-glass"></i></button>{{/eq}}{{/eq}}
      {{#eq theme.config.showThemeToggle true}}{{#ne theme.config.themeTogglePosition "corner"}}<button type="button" data-sb-theme-toggle class="btn btn-sm btn-outline-secondary cf-icon-btn" aria-label="切换深浅色"><i class="fa-solid fa-circle-half-stroke"></i></button>{{/ne}}{{/eq}}
    </div>
  </div>
</header>
