<a class="cf-card" href="{{url}}">
  {{#if coverImage}}<div class="cf-card-cover"><img src="{{coverImage}}" alt=""></div>{{/if}}
  <div class="cf-card-body">
    <h3 class="cf-card-title">{{title}}</h3>
    {{#if excerpt}}<p class="cf-card-excerpt">{{excerpt}}</p>{{/if}}
    <div class="cf-card-meta">
      {{#if publishedAt}}<time>{{format_date publishedAt format="MM-DD"}}</time>{{/if}}
      {{#if category}}<span>{{category.name}}</span>{{/if}}
    </div>
  </div>
</a>
