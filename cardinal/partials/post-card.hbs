<article class="card h-100 cf-card">
  {{#if coverImage}}<a href="{{url}}" class="cf-card-cover"><img src="{{coverImage}}" class="card-img-top" alt="" loading="lazy"></a>{{/if}}
  <div class="card-body">
    <h3 class="card-title h6"><a href="{{url}}">{{title}}</a></h3>
    {{#if excerpt}}<p class="card-text cf-card-excerpt">{{excerpt}}</p>{{/if}}
    <div class="cf-card-meta d-flex flex-wrap gap-2 align-items-center small text-secondary">
      {{#if publishedAt}}<time datetime="{{format_date publishedAt format="YYYY-MM-DD"}}">{{format_date publishedAt format="MM-DD"}}</time>{{/if}}
      {{#if category}}<a href="/categories/{{category.slug}}" class="text-secondary text-decoration-none">{{category.name}}</a>{{/if}}
      {{#if commentCount}}<span>{{commentCount}} 评论</span>{{/if}}
    </div>
  </div>
</article>
