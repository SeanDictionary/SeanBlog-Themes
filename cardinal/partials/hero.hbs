{{#eq theme.config.showHeroSection true}}
<section class="cf-hero">
  {{#eq theme.config.heroStyle "minimal"}}
  <h1>{{site.title}}</h1>
  {{#if site.description}}<p>{{site.description}}</p>{{/if}}
  {{/eq}}
  {{#eq theme.config.heroStyle "banner"}}
  <h1>{{site.title}}</h1>
  {{#if site.description}}<p>{{site.description}}</p>{{/if}}
  {{/eq}}
  {{#eq theme.config.heroStyle "fullscreen"}}
  <h1>{{site.title}}</h1>
  {{#if site.description}}<p>{{site.description}}</p>{{/if}}
  {{/eq}}
</section>
{{/eq}}
