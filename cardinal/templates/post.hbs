<article class="cf-post">
  <header class="cf-post-head">
    <p class="cf-post-kicker">文章</p>
    <h1 class="cf-post-title">{{post.title}}</h1>
    <div class="cf-post-meta">
      {{#each theme.config.articleMetaItems}}
        {{#eq this "publishedAt"}}{{#if ../post.publishedAt}}<span class="cf-meta-item"><time datetime="{{format_date ../post.publishedAt format="YYYY-MM-DD"}}">{{format_date ../post.publishedAt format="YYYY-MM-DD"}}</time></span>{{/if}}{{/eq}}
        {{#eq this "updatedAt"}}{{#if ../post.updatedAt}}<span class="cf-meta-item">更新于 {{format_date ../post.updatedAt format="YYYY-MM-DD"}}</span>{{/if}}{{/eq}}
        {{#eq this "viewCount"}}{{#if ../post.viewCount}}<span class="cf-meta-item">{{../post.viewCount}} 浏览</span>{{/if}}{{/eq}}
        {{#eq this "commentCount"}}{{#if ../comments.length}}<span class="cf-meta-item">{{../comments.length}} 评论</span>{{/if}}{{/eq}}
        {{#eq this "category"}}{{#if ../post.category}}<a class="cf-meta-item" href="/categories/{{../post.category.slug}}">{{../post.category.name}}</a>{{/if}}{{/eq}}
        {{#eq this "tags"}}{{!-- tags rendered separately below --}}{{/eq}}
      {{/each}}
      {{#eq theme.config.showReadingTime true}}<span class="cf-meta-item">{{post.readingMinutes}} 分钟 · {{post.wordCount}} 字</span>{{/eq}}
    </div>
    {{#if post.tags.length}}
    <div class="cf-post-tags">
      {{#each post.tags}}<a class="cf-tag" href="/tags/{{slug}}">{{name}}</a>{{/each}}
    </div>
    {{/if}}
    {{#if post.coverImage}}<img class="cf-post-cover" src="{{post.coverImage}}" alt="">{{/if}}
  </header>

  <div class="cf-post-content article-content">{{{content}}}</div>

  {{#eq theme.config.showArticleNav true}}
  <nav class="cf-post-nav">
    {{#if navigation.previous}}<a href="/articles/{{navigation.previous.slug}}" rel="prev">← {{navigation.previous.title}}</a>{{/if}}
    {{#if navigation.next}}<a href="/articles/{{navigation.next.slug}}" rel="next">{{navigation.next.title}} →</a>{{/if}}
  </nav>
  {{/eq}}

  <section id="sb-comments" class="cf-comments">
    <p class="cf-widget-title">{{comments.length}} 条评论</p>

    {{#each comments}}
    <article class="cf-comment" data-id="{{id}}">
      <div class="cf-comment-head">
        {{#if link}}<a class="cf-comment-author" href="{{link}}" target="_blank" rel="nofollow">{{author}}</a>{{else}}<span class="cf-comment-author">{{author}}</span>{{/if}}
        <span class="cf-comment-time">· {{format_date createdAt format="YYYY-MM-DD HH:mm"}}</span>
      </div>
      <div class="cf-comment-body">{{#if replyToAuthor}}<span class="cf-reply-at">@{{replyToAuthor}} </span>{{/if}}{{content}}</div>
      <button type="button" class="cf-comment-reply-btn" data-sb-reply-to="{{id}}" data-sb-reply-author="{{author}}">回复</button>
      {{#if replies.length}}
      <div class="cf-comment-replies">
        {{#each replies}}
        <article class="cf-comment" data-id="{{id}}">
          <div class="cf-comment-head"><span class="cf-comment-author">{{author}}</span><span class="cf-comment-time">· {{format_date createdAt format="MM-DD HH:mm"}}</span></div>
          <div class="cf-comment-body">{{#if replyToAuthor}}<span class="cf-reply-at">@{{replyToAuthor}} </span>{{/if}}{{content}}</div>
          <button type="button" class="cf-comment-reply-btn" data-sb-reply-to="{{id}}" data-sb-reply-author="{{author}}">回复</button>
        </article>
        {{/each}}
      </div>
      {{/if}}
    </article>
    {{/each}}

    {{#ne commentsMode "disabled"}}
    <form class="cf-comment-form" data-sb-comment-form data-sb-comment-target="#sb-comments" data-article-id="{{post.id}}">
      <div class="cf-reply-banner" data-sb-reply-banner hidden><span data-sb-reply-text></span> <button type="button" class="btn btn-sm btn-outline-secondary" data-sb-reply-cancel>取消</button></div>
      <div class="cf-form-row">
        <label class="cf-field form-label">昵称<input name="guestName" type="text" class="form-control" placeholder="你的昵称" autocomplete="name"></label>
        <label class="cf-field form-label">邮箱<input name="guestEmail" type="email" class="form-control" placeholder="email@example.com" autocomplete="email"></label>
      </div>
      <label class="cf-field form-label" style="margin-bottom:0.75rem">网站<input name="guestLink" type="url" class="form-control" placeholder="https://（可选）" autocomplete="url"></label>
      <label class="cf-field form-label">评论<textarea name="content" class="form-control" placeholder="写下你的评论…" required></textarea></label>
      <input type="hidden" name="parentId" value="">
      <div class="cf-form-actions">
        <button type="submit" class="btn btn-primary">发表评论</button>
        <p class="cf-comment-status" data-sb-comment-status></p>
      </div>
    </form>
    {{/ne}}
  </section>
</article>
