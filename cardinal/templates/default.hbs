<!DOCTYPE html>
<html lang="{{site.locale}}" data-bs-theme="{{#eq theme.config.colorMode "light"}}light{{else}}dark{{/eq}}" data-theme="{{#eq theme.config.colorMode "light"}}light{{else}}dark{{/eq}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Lora:ital,wght@0,400;0,600;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  {{{font_awesome}}}
  {{{seo_head}}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="{{asset "assets/theme.css"}}">
  {{{theme_css}}}
  {{{callout_css}}}
</head>
<body class="cf-body cf-page-{{page}}" data-font="{{theme.config.fontFamily}}" data-heading="{{theme.config.headingFontFamily}}" data-radius="{{theme.config.borderRadius}}" data-shadow="{{theme.config.shadowStyle}}" data-width="{{theme.config.contentWidth}}" data-list="{{theme.config.articleListStyle}}" data-sep="{{theme.config.listSeparator}}" data-hero="{{theme.config.heroStyle}}" data-sidebar="{{theme.config.sidebarPosition}}" data-sticky="{{theme.config.sidebarSticky}}" data-header="{{theme.config.headerBehavior}}" data-blur="{{theme.config.headerBlur}}" data-show-line-numbers="{{theme.config.showCodeLineNumbers}}" data-code-theme="{{theme.config.codeBlockTheme}}" data-nav-align="{{theme.config.navAlignment}}" data-toc-only="{{#eq page "post"}}{{#eq theme.config.showPostToc true}}true{{/eq}}{{/eq}}">
  {{#eq theme.config.showTopBar true}}{{> header}}{{/eq}}
  <div class="cf-layout">
    {{#eq theme.config.sidebarPosition "left"}}
      {{#eq page "post"}}{{#eq theme.config.showPostToc true}}{{> post-toc-sidebar}}{{else}}{{> sidebar}}{{/eq}}{{else}}{{> sidebar}}{{/eq}}
    {{/eq}}
    <main class="cf-main">
      {{{body}}}
    </main>
    {{#eq theme.config.sidebarPosition "right"}}
      {{#eq page "post"}}{{#eq theme.config.showPostToc true}}{{> post-toc-sidebar}}{{else}}{{> sidebar}}{{/eq}}{{else}}{{> sidebar}}{{/eq}}
    {{/eq}}
    {{!-- sidebarPosition=none 但文章页开启 TOC：右侧补一个目录侧栏 --}}
    {{#eq theme.config.sidebarPosition "none"}}{{#eq page "post"}}{{#eq theme.config.showPostToc true}}{{> post-toc-sidebar}}{{/eq}}{{/eq}}{{/eq}}
  </div>
  {{> footer}}
  {{> search-dialog}}
  {{#eq theme.config.showBackToTop true}}<button class="cf-back-to-top" data-cf-back-to-top aria-label="返回顶部"><i class="fa-solid fa-arrow-up"></i></button>{{/eq}}
  {{#eq theme.config.showCommentJumpButton true}}{{#eq page "post"}}{{#ne commentsMode "disabled"}}<button class="cf-comment-jump" data-cf-comment-jump aria-label="跳转评论"><i class="fa-solid fa-comment"></i></button>{{/ne}}{{/eq}}{{/eq}}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js" referrerpolicy="no-referrer" defer></script>
  <script src="{{asset "assets/js/main.js"}}" defer></script>
{{{platform_enhance}}}
  <script>(function(){var m="{{theme.config.colorMode}}";if(document.cookie.indexOf("sb-theme=")>=0){var c=(document.cookie.match(/sb-theme=(dark|light)/)||[])[1];if(c)document.documentElement.setAttribute("data-bs-theme",c),document.documentElement.setAttribute("data-theme",c);}else if(m==="auto"){try{var d=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.setAttribute("data-bs-theme",d),document.documentElement.setAttribute("data-theme",d);}catch(e){}}})();</script>
</body>
</html>
