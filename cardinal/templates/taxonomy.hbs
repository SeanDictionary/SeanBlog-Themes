<header class="cf-archive-head">
  <p class="cf-archive-kicker">{{#eq taxonomy.type "category"}}分类{{else}}标签{{/eq}}</p>
  <h1 class="cf-archive-title">{{taxonomy.name}}</h1>
  {{#if taxonomy.description}}<p class="cf-archive-desc">{{taxonomy.description}}</p>{{/if}}
</header>
<section class="cf-list">
  {{#if posts.length}}
  <div class="cf-posts" data-card-columns="{{#if theme.config.cardColumns}}{{theme.config.cardColumns}}{{else}}2{{/if}}" data-card-image-style="{{#if theme.config.cardImageStyle}}{{theme.config.cardImageStyle}}{{else}}default{{/if}}" data-title-color="{{#if theme.config.cardTitleColor}}{{theme.config.cardTitleColor}}{{else}}auto{{/if}}">
    {{#each posts}}{{> post-card}}{{/each}}
  </div>
  {{else}}
  <p class="cf-empty">暂无文章。</p>
  {{/if}}
</section>
{{> pagination}}
