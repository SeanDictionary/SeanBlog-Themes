<header class="cf-archive-head">
  <p class="cf-archive-kicker">搜索</p>
  <h1 class="cf-archive-title">{{query}}</h1>
  <p class="cf-archive-desc">共 {{pagination.total}} 篇</p>
</header>
<section class="cf-list">
  {{#if posts.length}}
  <div class="cf-posts" data-card-columns="{{#if theme.config.cardColumns}}{{theme.config.cardColumns}}{{else}}2{{/if}}" data-card-image-style="{{#if theme.config.cardImageStyle}}{{theme.config.cardImageStyle}}{{else}}default{{/if}}" data-title-color="{{#if theme.config.cardTitleColor}}{{theme.config.cardTitleColor}}{{else}}follow{{/if}}">
    {{#each posts}}{{> post-card}}{{/each}}
  </div>
  {{else}}
  <p class="cf-empty">没有找到相关文章。</p>
  {{/if}}
</section>
{{> pagination}}
