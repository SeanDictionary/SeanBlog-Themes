{{> hero}}

{{#eq theme.config.showPinned true}}
{{#if pinned.length}}
<section class="cf-featured">
  <p class="cf-list-title">置顶</p>
  <div class="cf-posts">
    {{#each pinned}}{{> post-card}}{{/each}}
  </div>
</section>
{{/if}}
{{/eq}}

<section class="cf-list">
  <div class="cf-list-head">
    <p class="cf-list-title">{{#eq pagination.page 1}}最新文章{{else}}第 {{pagination.page}} 页{{/eq}}</p>
    <nav class="cf-sort">
      {{#each sortOptions}}<a href="{{href}}" {{#eq value ../sort}}aria-current="true"{{/eq}}>{{label}}</a>{{/each}}
    </nav>
  </div>
  {{#if posts.length}}
  <div class="cf-posts">
    {{#eq theme.config.showPinned true}}
      {{#each posts}}{{#unless isPinned}}{{> post-card}}{{/unless}}{{/each}}
    {{else}}
      {{#each posts}}{{> post-card}}{{/each}}
    {{/eq}}
  </div>
  {{else}}
  <p class="cf-empty">这里还没有文章。</p>
  {{/if}}
</section>

{{> pagination}}
